---
// Plantilla de documento legal. Resuelve título, descripción, fecha y render del
// Markdown. El texto vive SOLO en el Markdown; este componente no duplica contenido.
import PublicHeader from './PublicHeader.astro'
import PublicFooter from './PublicFooter.astro'
import LegalNav from './LegalNav.astro'
import ContactForm from './ContactForm.tsx'
import type { LegalEntry } from '../../lib/legal'

interface Props {
  entry: LegalEntry
  Content: any
}

const { entry, Content } = Astro.props
const { title, description, updatedAt } = entry.data

// /soporte aloja el formulario real (CTA de la landing → /soporte#contacto).
const isSupport = entry.data.slug === 'soporte'

const fmt = new Intl.DateTimeFormat('es-NI', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})
const updated = fmt.format(updatedAt)
const currentPath = `/${entry.data.slug}`
---

<PublicHeader currentPath={currentPath} />

<main class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
  <div class="grid gap-10 lg:grid-cols-[240px_minmax(0,1fr)]">
    <LegalNav activeSlug={entry.data.slug} />

    <article class="min-w-0">
      <header class="border-b border-slate-200 pb-6">
        <h1 class="font-display text-3xl font-extrabold leading-tight tracking-tight text-navy sm:text-4xl">
          {title}
        </h1>
        <p class="mt-3 text-lg leading-relaxed text-neutral-text">{description}</p>
        <p class="mt-4 text-sm text-neutral-text">
          Última actualización: <time datetime={updatedAt.toISOString().slice(0, 10)}>{updated}</time>
        </p>
      </header>

      {
        isSupport && (
          <section id="contacto" class="mt-8 scroll-mt-24 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <h2 class="font-display text-xl font-bold text-navy">Envíanos un mensaje</h2>
            <p class="mt-1 text-sm text-neutral-text">
              Completa el formulario y te respondemos directamente a tu correo.
            </p>
            <div class="mt-5">
              <ContactForm client:load />
            </div>
          </section>
        )
      }

      <!-- Render del Markdown nativo de Astro. Sin set:html arbitrario. -->
      <div class="prose-legal mt-8">
        <Content />
      </div>
    </article>
  </div>
</main>

<PublicFooter />

<style is:global>
  /* Tipografía del cuerpo legal — legible y consistente con Poppins (brand book §04). */
  .prose-legal {
    @apply text-[1.0625rem] leading-relaxed text-secondary;
  }
  .prose-legal h2 {
    @apply mt-10 font-display text-2xl font-bold tracking-tight text-navy;
  }
  .prose-legal h3 {
    @apply mt-8 font-display text-lg font-bold text-navy;
  }
  .prose-legal p {
    @apply mt-4;
  }
  .prose-legal ul,
  .prose-legal ol {
    @apply mt-4 list-disc space-y-2 pl-6;
  }
  .prose-legal ol {
    @apply list-decimal;
  }
  .prose-legal a {
    @apply font-medium text-primary-600 underline-offset-2 hover:underline;
  }
  .prose-legal strong {
    @apply font-semibold;
  }
  .prose-legal blockquote {
    @apply mt-6 border-l-4 border-primary bg-primary-50 px-5 py-4 text-sm text-neutral-text;
  }
  .prose-legal blockquote p {
    @apply mt-0;
  }
  .prose-legal table {
    @apply mt-6 w-full border-collapse overflow-hidden rounded-lg text-sm;
  }
  .prose-legal thead th {
    @apply border-b border-slate-300 bg-neutral-bg px-4 py-2 text-left font-display font-bold text-navy;
  }
  .prose-legal tbody td {
    @apply border-b border-slate-200 px-4 py-2 align-top;
  }
</style>
