---
// Header público — logo Orbit + navegación mínima + acceso al panel.
// Reutiliza el logo real del login (`orbit-logo-version-finalv2.png`) y los tokens
// de marca del tailwind.config (primary naranja, navy, neutral.bg).
const { currentPath } = Astro.props
const nav = [
  { href: '/main#producto', label: 'Producto' },
  { href: '/soporte', label: 'Soporte' },
]
const isActive = (href: string) => currentPath && currentPath.startsWith(href.split('#')[0])
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/main" class="flex items-center gap-3" aria-label="Orbit — inicio">
      <img
        src="/orbit-logo-version-finalv2.png"
        alt="Orbit"
        width="40"
        height="40"
        class="h-10 w-10 object-contain"
      />
      <span class="font-display text-lg font-extrabold tracking-tight text-navy">Orbit</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'text-primary-600'
                : 'text-secondary hover:text-primary-600',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/"
        class="hidden text-sm font-medium text-secondary transition-colors hover:text-primary-600 sm:block"
      >
        Acceder al sistema
      </a>
      <a
        href="/"
        class="inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-600"
      >
        Ingresar
      </a>
    </div>
  </div>
</header>
