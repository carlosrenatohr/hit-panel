---
// Navegación lateral del centro legal — solo documentos publicados.
import { getPublishedLegal } from '../../lib/legal'

const published = await getPublishedLegal()
const { activeSlug } = Astro.props
---

<aside class="lg:sticky lg:top-24 lg:self-start">
  <h2 class="font-display text-sm font-bold uppercase tracking-wider text-navy">Documentos</h2>
  <nav class="mt-4" aria-label="Documentos legales">
    <ul class="space-y-1 border-l border-slate-200">
      {
        published.map((entry) => {
          const active = entry.data.slug === activeSlug
          return (
            <li>
              <a
                href={`/${entry.data.slug}`}
                class:list={[
                  '-ml-px block border-l-2 py-2 pl-4 text-sm transition-colors',
                  active
                    ? 'border-primary font-semibold text-primary-600'
                    : 'border-transparent text-neutral-text hover:border-slate-300 hover:text-secondary',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {entry.data.title}
              </a>
            </li>
          )
        })
      }
    </ul>
  </nav>
</aside>
