---
// Footer público — solo enlaces a documentos PUBLICADOS (los drafts no aparecen).
import { getPublishedLegal } from '../../lib/legal'

const published = await getPublishedLegal()
const year = new Date().getFullYear()
const contacto = 'orbit.system.ni@gmail.com'
---

<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-3">
      <!-- Marca -->
      <div>
        <div class="flex items-center gap-3">
          <img
            src="/orbit-logo-version-finalv2.png"
            alt="Orbit"
            width="36"
            height="36"
            class="h-9 w-9 object-contain"
          />
          <span class="font-display text-lg font-extrabold tracking-tight text-navy">Orbit</span>
        </div>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-neutral-text">
          Plataforma de operación logística: seguimiento de paquetes y facturación para agencias
          de carga.
        </p>
      </div>

      <!-- Producto -->
      <div>
        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-navy">Producto</h2>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/main" class="text-neutral-text transition-colors hover:text-primary-600">Inicio</a></li>
          <li><a href="/main#producto" class="text-neutral-text transition-colors hover:text-primary-600">Qué hace Orbit</a></li>
          <li><a href="/soporte#contacto" class="text-neutral-text transition-colors hover:text-primary-600">Solicitar una demostración</a></li>
          <li><a href="/" class="text-neutral-text transition-colors hover:text-primary-600">Acceder al sistema</a></li>
        </ul>
      </div>

      <!-- Legal y contacto -->
      <div>
        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-navy">Legal</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            published.map((entry) => (
              <li>
                <a
                  href={`/${entry.data.slug}`}
                  class="text-neutral-text transition-colors hover:text-primary-600"
                >
                  {entry.data.title}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm">
          <span class="text-neutral-text">Contacto: </span>
          <a href={`mailto:${contacto}`} class="font-medium text-primary-600 hover:underline">{contacto}</a>
        </p>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-200 pt-6 text-sm text-neutral-text">
      © {year} Orbit. Todos los derechos reservados.
    </div>
  </div>
</footer>
